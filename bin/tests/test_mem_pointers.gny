// ==========================================================================
// Write through dereference — int32
// ==========================================================================

public routine ptr_write_i32(): int32;
var
  x: int32;
  p: pointer to int32;
begin
  x := 10;
  p := address of x;
  p^ := 99;
  return x;
end;

// ==========================================================================
// Write through dereference — int64
// ==========================================================================

public routine ptr_write_i64(): int64;
var
  x: int64;
  p: pointer to int64;
begin
  x := 0;
  p := address of x;
  p^ := 9999999999;
  return x;
end;

// ==========================================================================
// Write through dereference — float64
// ==========================================================================

public routine ptr_write_f64(): float64;
var
  x: float64;
  p: pointer to float64;
begin
  x := 0.0;
  p := address of x;
  p^ := 77.25;
  return x;
end;

// ==========================================================================
// Nil pointer — assign nil, compare to nil, int32 return
// ==========================================================================

public routine ptr_nil(): int32;
var
  p: pointer to int32;
begin
  p := nil;
  if p = nil then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Pointer not-nil comparison after address-of, int32 return
// ==========================================================================

public routine ptr_not_nil(): int32;
var
  x: int32;
  p: pointer to int32;
begin
  x := 1;
  p := address of x;
  if p <> nil then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Untyped pointer — nil check, int32 return
// ==========================================================================

public routine ptr_untyped(): int32;
var
  p: pointer;
begin
  p := nil;
  if p = nil then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Ampersand syntax — int32 return
// ==========================================================================

public routine ptr_ampersand(): int32;
var
  x: int32;
  p: pointer to int32;
begin
  x := 77;
  p := &x;
  return p^;
end;

// ==========================================================================
// Named pointer type via type block — int32 return
// ==========================================================================

type
  PInt32 = pointer to int32;

public routine ptr_named_type(): int32;
var
  x: int32;
  p: PInt32;
begin
  x := 55;
  p := address of x;
  return p^;
end;


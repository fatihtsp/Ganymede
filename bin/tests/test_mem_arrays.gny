module mem test_mem_arrays;

// ==========================================================================
// Basic static array — int32 elements, int32 return
// ==========================================================================

type
  TIntArray = array[0..4] of int32;

public routine intarr(): int32;
var
  a: TIntArray;
begin
  a[0] := 10;
  a[1] := 20;
  a[2] := 30;
  a[3] := 40;
  a[4] := 50;
  return a[0] + a[4];
end;

// ==========================================================================
// Inline array type — no named type, int32 return
// ==========================================================================

public routine inlinearr(): int32;
var
  a: array[0..2] of int32;
begin
  a[0] := 100;
  a[1] := 200;
  a[2] := 300;
  return a[0] + a[1] + a[2];
end;

// ==========================================================================
// int8 array elements
// ==========================================================================

type
  TByteArray = array[0..3] of int8;

public routine i8arr(): int8;
var
  a: TByteArray;
begin
  a[0] := 10;
  a[1] := 20;
  a[2] := 30;
  a[3] := 40;
  return a[0] + a[3];
end;

// ==========================================================================
// int16 array elements
// ==========================================================================

type
  TShortArray = array[0..3] of int16;

public routine i16arr(): int16;
var
  a: TShortArray;
begin
  a[0] := 1000;
  a[1] := 2000;
  a[2] := 3000;
  a[3] := 4000;
  return a[1] + a[2];
end;

// ==========================================================================
// int64 array elements
// ==========================================================================

type
  TBigArray = array[0..2] of int64;

public routine i64arr(): int64;
var
  a: TBigArray;
begin
  a[0] := 1000000000;
  a[1] := 2000000000;
  a[2] := 3000000000;
  return a[0] + a[2];
end;

// ==========================================================================
// uint8 array elements
// ==========================================================================

type
  TU8Array = array[0..2] of uint8;

public routine u8arr(): uint8;
var
  a: TU8Array;
begin
  a[0] := 100;
  a[1] := 150;
  a[2] := 200;
  return a[0] + a[1];
end;

// ==========================================================================
// uint16 array elements
// ==========================================================================

type
  TU16Array = array[0..2] of uint16;

public routine u16arr(): uint16;
var
  a: TU16Array;
begin
  a[0] := 10000;
  a[1] := 20000;
  a[2] := 30000;
  return a[1] + a[2];
end;


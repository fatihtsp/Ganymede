module mem test_mem_match;

// Match on discrete integer values
public routine matchval(x: int32): int32;
begin
  match x of
    1: return 10;
    2: return 20;
    3: return 30;
  else
    return -1;
  end;
end;

// Match with comma-separated labels
public routine matchmulti(x: int32): int32;
begin
  match x of
    1, 2, 3: return 100;
    4, 5, 6: return 200;
  else
    return 0;
  end;
end;

// Match with range labels
public routine matchrange(x: int32): int32;
begin
  match x of
    1..5:   return 1;
    6..10:  return 2;
    11..20: return 3;
  else
    return 0;
  end;
end;

// Match with mixed values and ranges
public routine matchmixed(x: int32): int32;
begin
  match x of
    0:        return 100;
    1..3:     return 200;
    4, 7, 9:  return 300;
    10..15:   return 400;
  else
    return -1;
  end;
end;

// Match with no else — unmatched falls through
public routine matchnoelse(x: int32): int32;
begin
  match x of
    1: return 10;
    2: return 20;
  end;
  return 0;
end;

end.

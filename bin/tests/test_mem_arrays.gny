// ==========================================================================
// Dynamic array — multiple arrays in one routine
// ==========================================================================

public routine dynarr_multi(): int64;
var
  a: array of int32;
  b: array of int64;
begin
  setlength(a, 2);
  setlength(b, 2);
  a[0] := 100;
  a[1] := 200;
  b[0] := 1000;
  b[1] := 2000;
  return a[0] + a[1] + b[0] + b[1];
end;

// ==========================================================================
// Dynamic array — element arithmetic
// ==========================================================================

public routine dynarr_elemmath(): int32;
var
  a: array of int32;
begin
  setlength(a, 5);
  a[0] := 10;
  a[1] := 20;
  a[2] := 30;
  a[3] := 40;
  a[4] := 50;
  // (10 * 50) + (20 + 30 + 40) = 500 + 90 = 590
  return a[0] * a[4] + a[1] + a[2] + a[3];
end;

// ==========================================================================
// Dynamic array — element as function argument

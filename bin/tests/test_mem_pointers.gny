module mem test_mem_pointers;

// ==========================================================================
// int8 pointer — address of + deref, int8 return
// ==========================================================================

public routine ptr_i8(): int8;
var
  x: int8;
  p: pointer to int8;
begin
  x := 127;
  p := address of x;
  return p^;
end;

// ==========================================================================
// int16 pointer — int16 return
// ==========================================================================

public routine ptr_i16(): int16;
var
  x: int16;
  p: pointer to int16;
begin
  x := 30000;
  p := address of x;
  return p^;
end;


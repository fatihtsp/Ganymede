type
  TU32Array = array[0..2] of uint32;

public routine u32arr(): uint32;
var
  a: TU32Array;
begin
  a[0] := 100000;
  a[1] := 200000;
  a[2] := 300000;
  return a[0] + a[2];
end;

// ==========================================================================
// float32 array elements
// ==========================================================================

type
  TF32Array = array[0..2] of float32;

public routine f32arr(): float32;
var
  a: TF32Array;
begin
  a[0] := 1.5;
  a[1] := 2.5;
  a[2] := 3.5;
  return a[0] + a[2];
end;

// ==========================================================================
// float64 array elements
// ==========================================================================

type
  TF64Array = array[0..2] of float64;

public routine f64arr(): float64;
var
  a: TF64Array;
begin
  a[0] := 10.25;
  a[1] := 20.50;
  a[2] := 30.75;
  return a[0] + a[1];
end;

// ==========================================================================
// boolean array elements
// ==========================================================================

type
  TBoolArray = array[0..3] of boolean;

public routine boolarr(): boolean;
var
  a: TBoolArray;
begin
  a[0] := true;
  a[1] := false;
  a[2] := true;
  a[3] := true;
  return a[0] and a[2] and a[3];
end;

public routine boolarrfalse(): boolean;
var
  a: TBoolArray;
begin
  a[0] := true;
  a[1] := false;
  a[2] := true;
  a[3] := false;
  return a[0] and a[1];
end;

// ==========================================================================
// Element arithmetic — expressions using multiple elements
// ==========================================================================

public routine elemmath(): int32;
var
  a: TIntArray;
begin
  a[0] := 10;
  a[1] := 20;
  a[2] := 30;
  a[3] := 40;
  a[4] := 50;
  // (10 * 50) + (20 + 30 + 40) = 500 + 90 = 590
  return a[0] * a[4] + a[1] + a[2] + a[3];
end;

// ==========================================================================
// Loop fill and sum — variable index
// ==========================================================================

public routine loopsum(): int32;
var
  a: array[0..9] of int32;
  i: int32;
  s: int32;
begin
  // Fill: a[i] = (i+1) * 10
  for i := 0 to 9 do
    a[i] := (i + 1) * 10;
  end;

  // Sum all elements: 10+20+...+100 = 550
  s := 0;
  for i := 0 to 9 do
    s := s + a[i];
  end;

  return s;
end;

// ==========================================================================
// Element overwrite — write, then overwrite, return new value
// ==========================================================================

public routine overwrite(): int32;
var
  a: TIntArray;
begin
  a[0] := 100;
  a[1] := 200;
  a[0] := 999;
  a[1] := a[0] + 1;
  return a[0] + a[1];
end;

// ==========================================================================
// Boundary access — first and last elements
// ==========================================================================

type
  TBoundArray = array[0..99] of int32;

public routine boundary(): int32;
var
  a: TBoundArray;
begin
  a[0] := 1;
  a[99] := 99;
  return a[0] + a[99];
end;

// ==========================================================================
// Multiple array vars of different types in same routine
// ==========================================================================

public routine multiarray(): int64;
var
  ai: TIntArray;
  af: TF64Array;
  r: int64;
begin
  ai[0] := 100;
  ai[1] := 200;
  af[0] := 1.5;
  af[1] := 2.5;
  // 100 + 200 = 300, then 300 + 4 (int truncation of 1.5+2.5) = 304
  r := ai[0] + ai[1];
  return r;
end;

// ==========================================================================
// Pass array element to a function
// ==========================================================================

routine addtwo(a: int32; b: int32): int32;
begin
  return a + b;
end;

public routine elemarg(): int32;
var
  a: TIntArray;
begin
  a[0] := 42;
  a[1] := 58;
  return addtwo(a[0], a[1]);
end;

// ==========================================================================
// Array of records — named record type as element
// ==========================================================================

type
  TPoint = record
    x: int32;
    y: int32;
  end;

type
  TPointArray = array[0..2] of TPoint;

public routine recarr(): int32;
var
  pts: TPointArray;
begin
  pts[0].x := 1;
  pts[0].y := 2;
  pts[1].x := 10;
  pts[1].y := 20;
  pts[2].x := 100;
  pts[2].y := 200;
  return pts[0].x + pts[1].y + pts[2].x;
end;

// ==========================================================================
// Conditional on array element
// ==========================================================================

public routine condelem(): int32;
var
  a: TIntArray;
begin
  a[0] := 10;
  a[1] := 5;
  if a[0] > a[1] then
    return a[0];
  else
    return a[1];
  end;
end;

// ==========================================================================
// Nested loop with two arrays — copy from one to another
// ==========================================================================

public routine arrcopy(): int32;
var
  src: TIntArray;
  dst: TIntArray;
  i: int32;
begin
  src[0] := 11;
  src[1] := 22;
  src[2] := 33;
  src[3] := 44;
  src[4] := 55;

  for i := 0 to 4 do
    dst[i] := src[i];
  end;

  return dst[0] + dst[2] + dst[4];
end;

// ==========================================================================
// Kitchen sink — all integer element types in one routine, int64 return
// ==========================================================================

public routine kitchensink(): int64;
var
  ai8: TByteArray;
  ai16: TShortArray;
  ai32: TIntArray;
  ai64: TBigArray;
  au8: TU8Array;
  au16: TU16Array;
  au32: TU32Array;
  r: int64;
begin
  ai8[0] := 1;
  ai16[0] := 2;
  ai32[0] := 3;
  ai64[0] := 4;
  au8[0] := 5;
  au16[0] := 6;
  au32[0] := 7;
  // 1+2+3+4+5+6+7 = 28
  r := ai8[0] + ai16[0] + ai32[0] + ai64[0] + au8[0] + au16[0] + au32[0];
  return r;
end;

// ==========================================================================
// Dynamic array — setlength, write, read, sum
// ==========================================================================

public routine dynarr_basic(): int32;
var
  a: array of int32;
  s: int32;
begin
  setlength(a, 5);
  a[0] := 10;
  a[1] := 20;
  a[2] := 30;
  a[3] := 40;
  a[4] := 50;
  s := a[0] + a[1] + a[2] + a[3] + a[4];
  return s;
end;

// ==========================================================================
// Dynamic array — len() intrinsic
// ==========================================================================

public routine dynarr_len(): int64;
var
  a: array of int32;
begin
  setlength(a, 10);
  return len(a);
end;

// ==========================================================================
// Dynamic array — len() on nil (before setlength)
// ==========================================================================

public routine dynarr_len_nil(): int64;
var
  a: array of int32;
begin
  return len(a);
end;

// ==========================================================================
// Dynamic array — loop fill and sum
// ==========================================================================

public routine dynarr_loopsum(): int32;
var
  a: array of int32;
  i: int32;
  s: int32;
begin
  setlength(a, 10);
  for i := 0 to 9 do
    a[i] := (i + 1) * 10;
  end;

  s := 0;
  for i := 0 to 9 do
    s := s + a[i];
  end;

  return s;
end;

// ==========================================================================
// Dynamic array — int64 elements
// ==========================================================================

public routine dynarr_i64(): int64;
var
  a: array of int64;
begin
  setlength(a, 3);
  a[0] := 1000000000;
  a[1] := 2000000000;
  a[2] := 3000000000;
  return a[0] + a[2];
end;

// ==========================================================================
// Dynamic array — element overwrite
// ==========================================================================

public routine dynarr_overwrite(): int32;
var
  a: array of int32;
begin
  setlength(a, 2);
  a[0] := 100;
  a[1] := 200;
  a[0] := 999;
  a[1] := a[0] + 1;
  return a[0] + a[1];
end;

// ==========================================================================
// Dynamic array — setlength with expression
// ==========================================================================

public routine dynarr_expr_len(): int64;
var
  a: array of int32;
  n: int32;
begin
  n := 3 + 2;
  setlength(a, n);
  return len(a);
end;


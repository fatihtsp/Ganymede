module mem test_mem_choices_sets;

// ==========================================================================
// Choices (enum) — auto-assigned ordinals
// ==========================================================================

type
  TColor = choices(red, green, blue);

public routine enumval(): int32;
var
  c: TColor;
begin
  c := green;
  return c;
end;

// ==========================================================================
// Choices — explicit ordinal values
// ==========================================================================

type
  TSeverity = choices(none = 0, warn = 5, fail = 10);

public routine explicitval(): int32;
var
  e: TSeverity;
begin
  e := fail;
  return e;
end;

// ==========================================================================
// Choices — first and last values
// ==========================================================================

public routine enumfirst(): int32;
var
  c: TColor;
begin
  c := red;
  return c;
end;

public routine enumlast(): int32;
var
  c: TColor;
begin
  c := blue;
  return c;
end;

// ==========================================================================
// Set — membership test (element present)
// ==========================================================================

type
  TSmallSet = set of 0..63;

public routine setmember(): int32;
var
  s: TSmallSet;
begin
  s := [1, 3, 5..10];
  if 7 in s then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Set — membership test (element absent)
// ==========================================================================

public routine setnomember(): int32;
var
  s: TSmallSet;
begin
  s := [1, 3, 5..10];
  if 2 in s then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Set — empty set check
// ==========================================================================

public routine setempty(): int32;
var
  s: TSmallSet;
begin
  s := [];
  if 1 in s then
    return 1;
  end;
  return 0;
end;

// ==========================================================================
// Set — boundary elements
// ==========================================================================

public routine setboundary(): int32;
var
  s: TSmallSet;
begin
  s := [5..10];
  if (5 in s) and (10 in s) and (not (4 in s)) then
    return 1;
  end;
  return 0;
end;

end.
